# Kopieer dit bestand naar .env en vul je eigen key in.
# Committeer .env nooit.

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash

